<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Navbar Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topNavbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Ride Details"
            android:textColor="@color/waygo_yellow"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topNavbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Ride Information"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Source" android:textColor="@color/waygo_gray" android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etEditSource"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edit_text_background"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Destination" android:textColor="@color/waygo_gray" android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etEditDestination"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edit_text_background"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date" android:textColor="@color/waygo_gray" android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etEditDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edit_text_background"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time" android:textColor="@color/waygo_gray" android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etEditTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edit_text_background"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seats" android:textColor="@color/waygo_gray" android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etEditSeats"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edit_text_background"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Price (₹)" android:textColor="@color/waygo_gray" android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etEditPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edit_text_background"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:layout_marginBottom="40dp"/>

            <Button
                android:id="@+id/btnSaveRide"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/waygo_yellow"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

            <Button
                android:id="@+id/btnDeleteRideAction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="Delete Ride"
                android:textAllCaps="false"
                android:textColor="#F44336"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>